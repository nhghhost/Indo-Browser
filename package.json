{
  "name": "indo-browser",
  "version": "0.1.0-beta.1",
  "description": "Modern web browser with DRM support and privacy-focused features. No telemetry, no tracking.",
  "main": "main.js",
  "author": {
    "name": "Naufal Haidar Putera Syarif",
    "email": "naufalhaidar442@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/nhghhost/Indo-Browser#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhghhost/Indo-Browser.git"
  },
  "keywords": [
    "browser",
    "electron",
    "chromium",
    "widevine",
    "drm",
    "privacy",
    "no-telemetry",
    "multi-tab"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder build --win --x64",
    "build:dir": "electron-builder --dir",
    "clean": "rmdir /s /q dist"
  },
  "build": {
    "appId": "com.indo.browser",
    "productName": "Indo Browser",
    "compression": "normal",
    "electronDist": "electron-cache",
    "electronVersion": "33.2.1+wvcus",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "history.json",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "sign": null,
      "signingHashAlgorithms": []
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "differentialPackage": false
    },
    "portable": {
      "useZip": false
    }
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v33.2.1+wvcus",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}